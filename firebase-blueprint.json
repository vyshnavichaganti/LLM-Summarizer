{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user profile information.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique identifier for the user."
        },
        "displayName": {
          "type": "string",
          "description": "The display name of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the user."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "The URL of the user's profile photo."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the profile was created."
        },
        "notifications": {
          "type": "object",
          "description": "User notification preferences.",
          "properties": {
            "emailSummaries": { "type": "boolean" },
            "activityAlerts": { "type": "boolean" },
            "weeklyDigest": { "type": "boolean" },
            "newFeatures": { "type": "boolean" }
          }
        },
        "privacy": {
          "type": "object",
          "description": "User privacy preferences.",
          "properties": {
            "publicProfile": { "type": "boolean" },
            "dataSharing": { "type": "boolean" },
            "searchIndexing": { "type": "boolean" }
          }
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Username": {
      "title": "Username Mapping",
      "description": "Maps a username to a user's email and UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      },
      "required": ["uid", "email"]
    },
    "Summary": {
      "title": "Summary Record",
      "description": "Stores a summary generated by a user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "url": { "type": "string" },
        "type": { "type": "string", "enum": ["URL", "File", "Text"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "isPublic": { "type": "boolean", "description": "Whether the summary is publicly accessible via a share link." },
        "shareId": { "type": "string", "description": "A unique identifier for sharing." },
        "keySections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "content": { "type": "string" }
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": { "type": "string" },
              "category": { "type": "string" },
              "title": { "type": "string" }
            }
          }
        },
        "mainTopics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hasProgrammingContent": { "type": "boolean" },
        "extractedCodeSnippets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "language": { "type": "string" },
              "code": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      },
      "required": ["uid", "title", "summary", "type", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document."
    },
    "/usernames/{username}": {
      "schema": "Username",
      "description": "Username to email/UID mapping."
    },
    "/summaries/{summaryId}": {
      "schema": "Summary",
      "description": "Summary record document."
    }
  }
}
